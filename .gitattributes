# Arquivos de terceiros do motor de OCR (Tesseract.js) — tamanhos exatos
# testados e aprovados (Plano 19, seção 0). Nunca deixar o Git normalizar
# fim de linha aqui: isso mudaria o tamanho em bytes no checkout.
lib/tesseract/* -text

# Hooks sao shell script: precisam chegar com LF em qualquer maquina. Em CRLF
# o shebang carrega um retorno de carro invisivel no fim e o Linux/macOS
# recusam executar ("bad interpreter"). O Git Bash tolera; os outros nao.
.githooks/** text eol=lf
