  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/*",
            ".mp3",
            ".m4a",
            ".wav",
            ".ogg",
            ".webm",
            ".amr",
            ".3gp",
            ".flac"
          ]
        }
      ]
    }
